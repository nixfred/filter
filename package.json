{
  "name": "filter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Great Filter: an interactive Fermi paradox simulator. filter.nixfred.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nixfred/filter.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write_build_metadata.mjs",
    "preview": "vite preview --port 4517 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility --project=chromium",
    "test:simulation": "vitest run tests/unit/simulation",
    "check:bundle": "node scripts/check_bundle.mjs",
    "check:all": "npm run format:check && npm run lint && npm run typecheck && npm run test:simulation && npm run test:coverage && npm run build && npm run check:bundle && npm run test:e2e && npm run test:a11y",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy:preview": "wrangler pages deploy dist --project-name \"$CLOUDFLARE_PAGES_PROJECT\" --branch preview",
    "pages:deploy:production": "wrangler pages deploy dist --project-name \"$CLOUDFLARE_PAGES_PROJECT\" --branch main"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/web-worker": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
